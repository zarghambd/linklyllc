---
import type { CaseStudy } from '../data/case-studies';

export type Props = { study: CaseStudy };

const { study } = Astro.props;

// An unpublished study is scaffolding, not a case study. Rendering its
// `[PLACEHOLDER: ...]` tokens would put template tokens in front of a visitor,
// so the card shows a neutral summary instead and names nothing.
const isPublished = study.published;

const sector = isPublished ? study.sector : null;
const client = isPublished ? study.client : 'Project details coming soon';
const summary = isPublished
	? study.summary
	: 'This engagement is still being prepared for publication. In the meantime, ask us directly about work of this kind and we will walk you through what we delivered.';
const scope = isPublished ? study.scope : [];
const stack = isPublished ? study.stack : [];
---

{
	!isPublished && (
		<p class="case-study__notice">
			No verified case studies are published yet. Nothing below is a real client
			engagement, so we have not dressed it up as one.
		</p>
	)
}

<article class="card card-content case-study">
	<header class="case-study__header">
		{sector && <p class="case-study__sector">{sector}</p>}
		<h3 class="card-content__title">{client}</h3>
		{
			!isPublished && (
				<p class="case-study__badge">
					<span class="sr-only">Status: </span>
					Awaiting a verified engagement
				</p>
			)
		}
	</header>

	<p class="card-content__text">{summary}</p>

	{
		study.results && study.results.length > 0 && (
			<dl class="case-study__results">
				{study.results.map(result => (
					<div class="case-study__result">
						<dt>{result.label}</dt>
						<dd>{result.value}</dd>
					</div>
				))}
			</dl>
		)
	}

	{
		scope.length > 0 && (
			<>
				<h4 class="case-study__subhead">Scope</h4>
				<ul class="case-study__scope">
					{scope.map(item => (
						<li>{item}</li>
					))}
				</ul>
			</>
		)
	}

	{
		stack.length > 0 && (
			<div class="card-content__footer">
				<ul class="case-study__stack" aria-label="Technology used">
					{stack.map(tech => (
						<li class="case-study__tech">{tech}</li>
					))}
				</ul>
			</div>
		)
	}
</article>

<style>
	.case-study {
		gap: 1rem;
	}

	.case-study__notice {
		margin: 0 0 1.5rem;
		padding: 1rem 1.15rem;
		border: 1px solid var(--theme-border);
		border-left: 3px solid var(--color-brand-ink);
		border-radius: var(--border-radius-sm);
		background: var(--theme-surface-1);
		color: var(--theme-muted);
		max-width: 62ch;
	}

	.case-study__header {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.case-study__sector {
		margin: 0;
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-brand-ink);
	}

	.case-study__badge {
		align-self: flex-start;
		margin: 0.35rem 0 0;
		padding: 0.3rem 0.65rem;
		border-radius: 999px;
		background: var(--theme-surface-2);
		border: 1px solid var(--theme-border);
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--theme-muted);
	}

	.case-study__subhead {
		margin: 0.5rem 0 0;
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--theme-muted);
	}

	.case-study__scope {
		margin: 0;
		padding-left: 1.15rem;
		display: grid;
		gap: 0.35rem;
		font-size: 0.94rem;
		color: var(--theme-muted);
	}

	.case-study__scope li {
		line-height: 1.6;
	}

	.case-study__results {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 7rem), 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0.9rem 1rem;
		border-radius: var(--border-radius-sm);
		background: var(--theme-surface-2);
	}

	.case-study__result {
		display: flex;
		flex-direction: column-reverse;
		gap: 0.1rem;
		margin: 0;
	}

	.case-study__result dd {
		margin: 0;
		font-family: var(--heading-font);
		font-size: 1.35rem;
		font-weight: 800;
		line-height: 1.1;
	}

	.case-study__result dt {
		font-size: 0.8rem;
		color: var(--theme-muted);
	}

	.case-study__stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.case-study__tech {
		padding: 0.3rem 0.65rem;
		border-radius: 999px;
		border: 1px solid var(--theme-border);
		background: var(--theme-surface-1);
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--theme-muted);
	}

	.case-study__header :global(.card-content__title) {
		margin-bottom: 0;
	}
</style>
