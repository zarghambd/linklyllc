---
import { Image } from 'astro:assets';
import logo from '../../public/linkly-logo.png';
---

<div class="brand-mark">
	<Image
		src={logo}
		alt="Linkly LLC"
		width={408}
		height={153}
		widths={[204, 306, 408]}
		sizes="(min-width: 921px) 220px, 180px"
		loading="eager"
		fetchpriority="high"
		decoding="async"
		class="brand-mark__image"
	/>
</div>

<style>
	.brand-mark {
		display: flex;
		align-items: center;
		justify-content: center;
		line-height: 1;
		padding: 0.2rem 0;
	}

	.brand-mark__image {
		display: block;
		width: clamp(140px, 16vw, 220px);
		height: auto;
		max-height: 56px;
		flex-shrink: 0;
		object-fit: contain;
		object-position: left center;
		border-radius: 8px;
	}
</style>
