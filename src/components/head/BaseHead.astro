---
import settings from '../../config/settings.js';
import { site } from '../../config/site';
import { plausibleDomain, plausibleEnabled } from '../../config/analytics';
import Seo from './Seo.astro';
import JsonLd from './JsonLd.astro';
import type { Props as SeoProps } from './Seo.astro';

export interface Props extends SeoProps {
	/** Extra JSON-LD merged into the site-wide @graph. */
	jsonLd?: Record<string, unknown>[];
}

import '../../styles/index.css';

const { jsonLd = [], ...seo } = Astro.props;

const origin = new URL(Astro.site ?? site.url);

/**
 * Site-wide structured data. `telephone` is omitted while the phone number is
 * unset rather than emitting a placeholder into Google's knowledge panel.
 */
const organizationSchema = {
	'@type': 'Organization',
	'@id': `${origin.origin}/#organization`,
	name: site.name,
	url: origin.origin,
	email: site.email,
	description: settings.description,
	logo: {
		'@type': 'ImageObject',
		url: new URL('/linkly-logo.png', origin).href,
	},
	...(site.phone ? { telephone: site.phone } : {}),
	sameAs: site.socials
		.filter(social => social.url.length > 0)
		.map(social => social.url),
};

const websiteSchema = {
	'@type': 'WebSite',
	'@id': `${origin.origin}/#website`,
	url: origin.origin,
	name: site.name,
	description: settings.description,
	publisher: { '@id': `${origin.origin}/#organization` },
	inLanguage: 'en-US',
};

const graph = [organizationSchema, websiteSchema, ...jsonLd];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta
	name="theme-color"
	content="#0b0f1a"
	media="(prefers-color-scheme: dark)"
/>
<meta
	name="theme-color"
	content="#f8f9fc"
	media="(prefers-color-scheme: light)"
/>
<meta name="color-scheme" content="light dark" />
<meta name="format-detection" content="telephone=no" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/linkly.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	rel="preload"
	as="style"
	href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
/>
<link
	rel="stylesheet"
	href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
/>

<Seo {...seo} />
<JsonLd schema={{ '@context': 'https://schema.org', '@graph': graph }} />

{
	/* Blocking on purpose: runs before first paint so the theme never flashes.
	is:inline keeps the src pointing at the public file instead of bundling it. */
}
<script is:inline src="/theme-init.js"></script>

{
	plausibleEnabled && (
		<>
			<meta name="plausible-domain" content={plausibleDomain} />
			<script is:inline src="/analytics.js" defer />
		</>
	)
}
