---
import Layout from './Page.astro';
import { site } from '../config/site';

export type TocEntry = {
	/** Anchor id, which must match the `id` on the matching heading. */
	id: string;
	title: string;
};

export type Props = {
	title: string;
	/** Short summary shown directly under the h1. */
	intro?: string;
	/** Effective / last-updated date shown in the page header. */
	lastUpdated: string;
	/** Table of contents entries, in document order. */
	toc: TocEntry[];
	seo: {
		title: string;
		description: string;
	};
};

const { title, intro, lastUpdated, toc, seo } = Astro.props;
const year = new Date().getFullYear();
---

<Layout seo={seo}>
	<div class="container legal-shell">
		<header class="legal-header">
			<p class="eyebrow">Legal</p>
			<h1>{title}</h1>
			{intro && <p class="legal-header__intro">{intro}</p>}
			<p class="legal-header__meta">
				<span
					>Last updated: <time datetime={lastUpdated}>{lastUpdated}</time></span
				>
				<button class="legal-header__print" type="button" data-print hidden>
					Print this page
				</button>
			</p>
		</header>

		<div class="legal-layout">
			<aside class="legal-toc" aria-labelledby="legal-toc-heading">
				<h2 class="legal-toc__heading" id="legal-toc-heading">On this page</h2>
				<nav aria-labelledby="legal-toc-heading">
					<ol class="legal-toc__list">
						{
							toc.map(entry => (
								<li>
									<a href={`#${entry.id}`}>{entry.title}</a>
								</li>
							))
						}
					</ol>
				</nav>
			</aside>

			<article class="legal-body prose" data-legal-body>
				<slot />
			</article>
		</div>

		<footer class="legal-footer">
			<p>
				{site.name} · <a href="/terms-of-service">Terms of Service</a> ·
				<a href="/privacy-policy">Privacy Policy</a> · <a href="/refund-policy"
					>Refund Policy</a
				>
			</p>
			<p>© {year} {site.name}. All rights reserved.</p>
		</footer>
	</div>
</Layout>

<script>
	// Progressive enhancement: the print control ships hidden, so without JS it
	// is never a visible button that does nothing.
	const printButton = document.querySelector<HTMLButtonElement>('[data-print]');
	if (printButton) {
		printButton.addEventListener('click', () => window.print());
		printButton.hidden = false;
	}

	// Highlight the table-of-contents entry for the section currently in view.
	const links = Array.from(
		document.querySelectorAll<HTMLAnchorElement>('.legal-toc__list a'),
	);
	const sections = links
		.map(link => {
			const id = decodeURIComponent(
				(link.getAttribute('href') ?? '').replace('#', ''),
			);
			const heading = id ? document.getElementById(id) : null;
			return heading ? { link, heading } : null;
		})
		.filter(
			(entry): entry is { link: HTMLAnchorElement; heading: HTMLElement } =>
				Boolean(entry),
		);

	if (sections.length > 0 && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver(
			entries => {
				for (const entry of entries) {
					const match = sections.find(s => s.heading === entry.target);
					if (!match) continue;
					if (entry.isIntersecting) {
						for (const section of sections)
							section.link.removeAttribute('aria-current');
						match.link.setAttribute('aria-current', 'true');
					}
				}
			},
			{ rootMargin: '0px 0px -70% 0px', threshold: 0 },
		);

		for (const section of sections) observer.observe(section.heading);
	}
</script>

<style>
	.legal-shell {
		max-width: 78rem;
		padding-block: clamp(2.5rem, 6vw, 4rem);
	}

	.legal-header {
		max-width: 46rem;
		margin-bottom: clamp(2rem, 4vw, 3rem);
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--theme-border);
	}

	.legal-header h1 {
		margin-bottom: 0.85rem;
	}

	.legal-header__intro {
		color: var(--theme-muted);
		font-size: clamp(1.02rem, 1.2vw, 1.12rem);
		line-height: 1.7;
	}

	.legal-header__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		margin: 1.25rem 0 0;
		font-size: 0.88rem;
		color: var(--theme-muted);
	}

	.legal-header__print {
		display: none;
		padding: 0;
		background: transparent;
		border: 0;
		font: inherit;
		font-weight: 600;
		color: var(--color-brand-ink);
		text-decoration: underline;
		text-underline-offset: 0.18em;
		cursor: pointer;
	}

	.legal-layout {
		display: grid;
		grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
		gap: clamp(2rem, 4vw, 3.5rem);
		align-items: start;
	}

	.legal-toc {
		position: sticky;
		top: calc(var(--header-height) + 1.5rem);
		max-height: calc(100vh - var(--header-height) - 3rem);
		overflow-y: auto;
		padding: 1.25rem;
		border: 1px solid var(--theme-border);
		border-radius: var(--border-radius);
		background: var(--theme-surface-1);
	}

	.legal-toc__heading {
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin-bottom: 0.9rem;
	}

	.legal-toc__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.55rem;
		counter-reset: toc;
	}

	.legal-toc__list a {
		display: block;
		font-size: 0.9rem;
		line-height: 1.45;
		color: var(--theme-muted);
		padding: 0.15rem 0.5rem 0.15rem 0;
		border-left: 2px solid transparent;
		padding-left: 0.75rem;
	}

	.legal-toc__list a:hover {
		color: var(--theme-on-bg);
	}

	.legal-toc__list a[aria-current='true'] {
		color: var(--color-brand-ink);
		border-left-color: var(--color-brand-ink);
		font-weight: 600;
	}

	.legal-body {
		max-width: 68ch;
	}

	.legal-body :global(h2) {
		/* Offset for the sticky header so an in-page anchor is not hidden. */
		scroll-margin-top: calc(var(--header-height) + 1.5rem);
	}

	.legal-body :global(h3) {
		scroll-margin-top: calc(var(--header-height) + 1.5rem);
	}

	.legal-footer {
		margin-top: clamp(2.5rem, 5vw, 4rem);
		padding-top: 1.5rem;
		border-top: 1px solid var(--theme-border);
		font-size: 0.88rem;
		color: var(--theme-muted);
	}

	.legal-footer p {
		margin: 0 0 0.35rem;
	}

	.legal-footer a {
		color: var(--color-brand-ink);
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	@media (max-width: 900px) {
		.legal-layout {
			grid-template-columns: 1fr;
		}

		.legal-toc {
			position: static;
			max-height: none;
		}
	}

	/* Above 900px the control sits beside the date. Below it, it is dropped:
	   mobile browsers expose printing from the share sheet instead. The
	   [hidden] guard keeps it invisible until the script binds the handler. */
	@media (min-width: 901px) {
		.legal-header__print:not([hidden]) {
			display: inline-block;
		}
	}

	/* Print: one column, black on white, TOC and footer chrome dropped so the
	   document reads as a contract rather than a web page. */
	@media print {
		.legal-toc,
		.legal-header__print,
		.site-header,
		.site-footer {
			display: none !important;
		}

		.legal-shell {
			max-width: none;
			padding: 0;
		}

		.legal-layout {
			display: block;
		}

		.legal-body {
			max-width: none;
			font-size: 11pt;
			line-height: 1.5;
			color: #000;
		}

		.legal-body :global(h2),
		.legal-body :global(h3) {
			page-break-after: avoid;
			break-after: avoid;
			color: #000;
		}

		.legal-body :global(p),
		.legal-body :global(li) {
			orphans: 3;
			widows: 3;
		}

		.legal-body :global(a) {
			color: #000;
			text-decoration: underline;
		}

		.legal-header h1,
		.legal-header__intro,
		.legal-header__meta,
		.legal-footer {
			color: #000;
		}

		.legal-header {
			border-bottom: 1pt solid #000;
		}
	}
</style>
