---
import Layout from './Base.astro';
import type { Props as BaseHeadProps } from '../components/head/BaseHead.astro';
import Logo from '../components/Logo.astro';
import settings from '../config/settings';

export interface Props {
	seo?: BaseHeadProps;
}

import { nav } from '../config/nav.js';

const { seo } = Astro.props as Props;
const currentPath = Astro.url.pathname;
const year = new Date().getFullYear();
---

<Layout seo={seo}>
	<header class="site-header">
		<div class="container site-header__inner">
			<a href="/" class="brand" aria-label="Linkly LLC home">
				<Logo />
			</a>

			<nav class="site-nav" aria-label="Main navigation">
				{nav.map((item) => {
					const isActive = item.slug === '/' ? currentPath === '/' : currentPath.startsWith(item.slug);
					return (
						<a class:list={['site-nav__link', { 'is-active': isActive }]} href={item.slug} aria-current={isActive ? 'page' : undefined}>
							{item.title}
						</a>
					);
				})}
			</nav>

			<div class="site-header__actions">
				<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Enable dark mode" title="Enable dark mode">
					<svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="12" cy="12" r="4.2" fill="currentColor" />
						<path d="M12 1.8v2.2m0 16v2.2M4.93 4.93l1.56 1.56m11.02 11.02 1.56 1.56M1.8 12h2.2m16 0h2.2M4.93 19.07l1.56-1.56m11.02-11.02 1.56-1.56" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
					</svg>
					<svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M20 14.5A7.5 7.5 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="currentColor" />
					</svg>
				</button>
			</div>

			<button class="nav-toggle" type="button" aria-expanded="false" aria-label="Toggle navigation menu">
				<span />
				<span />
				<span />
			</button>
		</div>
	</header>

	<div id="page">
		<slot />
	</div>

	<footer class="site-footer">
		<div class="container site-footer__grid">
			<div class="footer-brand">
				<a href="/" class="brand brand--footer" aria-label="Linkly LLC home">
					<Logo />
				</a>
				<p>Custom web development and product engineering for ambitious businesses.</p>
				<div class="social-list" aria-label="Social media links">
					<a href="https://twitter.com" target="_blank" rel="noreferrer" aria-label="X / Twitter">X</a>
					<a href="https://youtube.com" target="_blank" rel="noreferrer" aria-label="YouTube">YT</a>
					<a href="https://github.com" target="_blank" rel="noreferrer" aria-label="GitHub">GH</a>
					<a href="https://discord.com" target="_blank" rel="noreferrer" aria-label="Discord">DC</a>
				</div>
			</div>

			<div class="footer-column">
				<h3>Company</h3>
				<ul>
					<li><a href="/about">About</a></li>
					<li><a href="/services">Services</a></li>
					<li><a href="/contact">Contact</a></li>
				</ul>
			</div>

			<div class="footer-column">
				<h3>Services</h3>
				<ul>
					<li><a href="/services">Custom web apps</a></li>
					<li><a href="/services">AI automation</a></li>
					<li><a href="/stack">Technology stack</a></li>
				</ul>
			</div>

			<div class="footer-column">
				<h3>Contact</h3>
				<ul>
					<li><a href="mailto:hello@linklyllc.com">hello@linklyllc.com</a></li>
					<li><a href="tel:+18005550199">(800) 555-0199</a></li>
					<li><a href="/contact">Book a consultation</a></li>
				</ul>
			</div>
		</div>
		<div class="site-footer__bottom">
			<div class="container site-footer__bottom-inner">
				<span>© {year} {settings.name}. All rights reserved.</span>
			</div>
		</div>
	</footer>

	<script is:inline>
		const root = document.documentElement;
		const themeToggle = document.getElementById('theme-toggle');
		const navToggle = document.querySelector('.nav-toggle');
		const siteHeader = document.querySelector('.site-header');
		const navLinks = document.querySelectorAll('.site-nav__link');

		function syncThemeToggle() {
			if (!themeToggle) return;
			const isDark = root.dataset.theme === 'dark';
			themeToggle.setAttribute('aria-label', isDark ? 'Enable light mode' : 'Enable dark mode');
			themeToggle.setAttribute('title', isDark ? 'Enable light mode' : 'Enable dark mode');
			themeToggle.classList.toggle('is-dark', isDark);
		}

		const saveTheme = (theme) => {
			root.dataset.theme = theme;
			localStorage.setItem('theme', theme);
			syncThemeToggle();
		};

		if (themeToggle) {
			themeToggle.addEventListener('click', () => {
				const nextTheme = root.dataset.theme === 'dark' ? 'default' : 'dark';
				saveTheme(nextTheme);
			});
		}

		if (navToggle && siteHeader) {
			navToggle.addEventListener('click', () => {
				const isOpen = siteHeader.classList.toggle('is-open');
				navToggle.setAttribute('aria-expanded', String(isOpen));
				document.body.classList.toggle('menu-open', isOpen);
			});
		}

		navLinks.forEach((link) => {
			link.addEventListener('click', () => {
				if (siteHeader) siteHeader.classList.remove('is-open');
				if (navToggle) navToggle.setAttribute('aria-expanded', 'false');
				document.body.classList.remove('menu-open');
			});
		});

		syncThemeToggle();
	</script>

	<style>
		.site-header {
			position: sticky;
			top: 0;
			z-index: 30;
			backdrop-filter: blur(18px);
			background: rgba(248, 249, 252, 0.72);
			border-bottom: 1px solid rgba(229, 231, 239, 0.8);
		}

		:root[data-theme='dark'] .site-header {
			background: rgba(11, 15, 26, 0.72);
			border-bottom-color: rgba(35, 44, 68, 0.9);
		}

		.site-header__inner {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			width: 100%;
			max-width: 1400px;
			padding-inline: clamp(16px, 3vw, 40px);
			height: var(--header-height);
		}

		.brand {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			margin-right: auto;
			flex-shrink: 0;
		}

		.site-header .brand :global(img) {
			width: auto;
			height: 56px;
			max-width: 320px;
			max-height: 56px;
			display: block;
		}

		.site-nav {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}

		.site-nav__link {
			display: inline-flex;
			align-items: center;
			padding: 0.7rem 0.9rem;
			border-radius: 999px;
			font-size: 0.96rem;
			font-weight: 600;
			color: var(--theme-muted);
			transition: color var(--transition), background var(--transition);
		}

		.site-nav__link:hover,
		.site-nav__link.is-active {
			color: var(--theme-on-bg);
			background: rgba(109, 40, 217, 0.08);
		}

		.site-header__actions {
			display: flex;
			align-items: center;
			gap: 0.75rem;
		}

		.theme-toggle {
			position: relative;
			width: 2.75rem;
			height: 2.75rem;
			border: 1px solid var(--theme-border);
			background: rgba(255, 255, 255, 0.2);
			border-radius: 999px;
			display: grid;
			place-items: center;
			transition: transform var(--transition), border-color var(--transition), background var(--transition);
		}

		.theme-toggle:hover {
			transform: translateY(-1px);
			border-color: rgba(109, 40, 217, 0.35);
		}

		.theme-toggle__icon {
			position: absolute;
			width: 1.08rem;
			height: 1.08rem;
			transition: opacity var(--transition), transform var(--transition);
			color: var(--theme-on-bg);
		}

		.theme-toggle__icon--sun { opacity: 1; }
		.theme-toggle__icon--moon { opacity: 0; transform: scale(0.75); }
		.theme-toggle.is-dark .theme-toggle__icon--sun { opacity: 0; transform: scale(0.7); }
		.theme-toggle.is-dark .theme-toggle__icon--moon { opacity: 1; transform: scale(1); }

		.nav-toggle {
			display: none;
			padding: 0.3rem;
			background: transparent;
			border: 0;
			width: 2.5rem;
			height: 2.5rem;
			border-radius: 999px;
		}

		.nav-toggle span {
			display: block;
			width: 1.3rem;
			height: 2px;
			background: var(--theme-on-bg);
			border-radius: 999px;
			margin: 0.25rem auto;
		}

		.site-footer {
			background: var(--theme-surface-1);
			border-top: 1px solid var(--theme-border);
			margin-top: 2rem;
		}

		.site-footer__grid {
			display: grid;
			grid-template-columns: 1.5fr 1fr 1fr 1fr;
			gap: 2rem;
			padding: 64px 0 32px;
		}

		.footer-brand p {
			margin-top: 1rem;
			max-width: 22rem;
			color: var(--theme-muted);
		}

		.brand--footer img {
			width: clamp(170px, 15vw, 210px);
		}

		.social-list {
			display: flex;
			gap: 0.7rem;
			margin-top: 1.5rem;
			flex-wrap: wrap;
		}

		.social-list a {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 2.25rem;
			height: 2.25rem;
			border-radius: 999px;
			background: rgba(109, 40, 217, 0.08);
			border: 1px solid var(--theme-border);
			font-size: 0.74rem;
			font-weight: 700;
			color: var(--theme-on-bg);
		}

		.footer-column h3 {
			margin-bottom: 1rem;
			font-size: 1rem;
		}

		.footer-column ul {
			list-style: none;
			padding: 0;
			margin: 0;
			display: grid;
			gap: 0.6rem;
		}

		.footer-column a {
			color: var(--theme-muted);
		}

		.footer-column a:hover {
			color: var(--theme-on-bg);
		}

		.site-footer__bottom {
			border-top: 1px solid var(--theme-border);
			padding: 1.1rem 0;
		}

		.site-footer__bottom-inner {
			color: var(--theme-muted);
			font-size: 0.92rem;
		}

		@media (max-width: 920px) {
			.site-nav {
				display: none;
				position: absolute;
				top: 100%;
				left: 0;
				right: 0;
				padding: 1rem 1.25rem;
				background: var(--theme-surface-1);
				border-bottom: 1px solid var(--theme-border);
				flex-direction: column;
				align-items: stretch;
			}

			.site-header.is-open .site-nav {
				display: flex;
			}

			.nav-toggle {
				display: block;
			}
		}

		@media (max-width: 640px) {
			.site-header .brand :global(img) {
				height: 44px;
				max-height: 44px;
				max-width: 200px;
			}
		}

		@media (max-width: 640px) {
			.site-footer__grid {
				grid-template-columns: 1fr;
			}
		}
	</style>
</Layout>
