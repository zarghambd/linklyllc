---
import Layout from './Base.astro';
import type { Props as BaseHeadProps } from '../components/head/BaseHead.astro';
import Logo from '../components/Logo.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site, hasPhone } from '../config/site';
import { nav, footerNav } from '../config/nav.js';

export interface Props {
	seo?: BaseHeadProps;
}

const { seo } = Astro.props as Props;
const currentPath = Astro.url.pathname;

/** Longest-prefix match so /work still marks the Work tab active. */
function isCurrent(slug: string): boolean {
	if (slug === '/') return currentPath === '/';
	if (currentPath === slug) return true;
	return currentPath.startsWith(`${slug}/`);
}

const year = new Date().getFullYear();
---

<Layout seo={seo}>
	<header slot="header" class="site-header">
		<div class="container site-header__inner">
			<a href="/" class="brand" aria-label="Linkly LLC — home">
				<Logo />
			</a>

			<nav class="site-nav" id="site-nav" aria-label="Main">
				{
					nav.map(item => {
						const isActive = isCurrent(item.slug);
						return (
							<a
								class:list={['site-nav__link', { 'is-active': isActive }]}
								href={item.slug}
								aria-current={isActive ? 'page' : undefined}
							>
								{item.title}
							</a>
						);
					})
				}
			</nav>

			<div class="site-header__actions">
				<button
					id="theme-toggle"
					class="theme-toggle"
					type="button"
					aria-pressed="false"
				>
					<svg
						class="theme-toggle__icon theme-toggle__icon--sun"
						viewBox="0 0 24 24"
						aria-hidden="true"
						focusable="false"
					>
						<circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
						<path
							d="M12 1.8v2.2m0 16v2.2M4.93 4.93l1.56 1.56m11.02 11.02 1.56 1.56M1.8 12h2.2m16 0h2.2M4.93 19.07l1.56-1.56m11.02-11.02 1.56-1.56"
							fill="none"
							stroke="currentColor"
							stroke-linecap="round"
							stroke-width="1.8"></path>
					</svg>
					<svg
						class="theme-toggle__icon theme-toggle__icon--moon"
						viewBox="0 0 24 24"
						aria-hidden="true"
						focusable="false"
					>
						<path
							d="M20 14.5A7.5 7.5 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
							fill="currentColor"></path>
					</svg>
				</button>
			</div>

			<button
				class="nav-toggle"
				type="button"
				aria-expanded="false"
				aria-controls="site-nav"
			>
				<span class="nav-toggle__bars" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</span>
				<span class="sr-only">Menu</span>
			</button>
		</div>
	</header>

	<!-- Forwarded into Base.astro's default slot, which is the page <main>. -->
	<slot />

	<footer slot="footer" class="site-footer">
		<div class="container site-footer__grid">
			<div class="footer-brand">
				<a href="/" class="brand brand--footer" aria-label="Linkly LLC — home">
					<Logo />
				</a>
				<p>{site.tagline}</p>
				<SocialLinks />
			</div>

			<div class="footer-column">
				<h2 class="footer-column__title">Company</h2>
				<ul>
					{
						footerNav.company.map(item => (
							<li>
								<a href={item.slug}>{item.title}</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="footer-column">
				<h2 class="footer-column__title">Services</h2>
				<ul>
					{
						footerNav.services.map(item => (
							<li>
								<a href={item.slug}>{item.title}</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="footer-column">
				<h2 class="footer-column__title">Contact</h2>
				<ul>
					<li><a href={`mailto:${site.email}`}>{site.email}</a></li>
					{
						hasPhone && (
							<li>
								<a href={`tel:${site.phone}`}>{site.phone}</a>
							</li>
						)
					}
					<li><a href="/contact">Book a consultation</a></li>
				</ul>
			</div>

			<div class="footer-column">
				<h2 class="footer-column__title">Legal</h2>
				<ul>
					{
						footerNav.legal.map(item => (
							<li>
								<a href={item.slug}>{item.title}</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
		<div class="site-footer__bottom">
			<div class="container site-footer__bottom-inner">
				<span>© {year} {site.name}. All rights reserved.</span>
			</div>
		</div>
	</footer>

	<script>
		const root = document.documentElement;
		const themeToggle = document.getElementById('theme-toggle');
		const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
		const siteHeader = document.querySelector('.site-header');

		function syncThemeToggle() {
			if (!themeToggle) return;
			const isDark = root.dataset.theme === 'dark';
			// aria-pressed communicates the toggle's state, the visually hidden
			// label the action. Updating both covers assistive tech that reads
			// either.
			themeToggle.setAttribute('aria-pressed', String(isDark));
			themeToggle.setAttribute(
				'aria-label',
				isDark ? 'Switch to light theme' : 'Switch to dark theme',
			);
			themeToggle.setAttribute(
				'title',
				isDark ? 'Switch to light theme' : 'Switch to dark theme',
			);
			themeToggle.classList.toggle('is-dark', isDark);
		}

		if (themeToggle) {
			themeToggle.addEventListener('click', () => {
				const nextTheme = root.dataset.theme === 'dark' ? 'default' : 'dark';
				root.dataset.theme = nextTheme;
				try {
					localStorage.setItem('theme', nextTheme);
				} catch {
					// Storage can be blocked; the theme still applies for this page view.
				}
				syncThemeToggle();
			});
		}

		function setMenu(open: boolean) {
			if (!navToggle || !siteHeader) return;
			siteHeader.classList.toggle('is-open', open);
			navToggle.setAttribute('aria-expanded', String(open));
			document.body.classList.toggle('menu-open', open);
		}

		if (navToggle && siteHeader) {
			navToggle.addEventListener('click', () => {
				setMenu(!siteHeader.classList.contains('is-open'));
			});

			// Escape closes the mobile menu and returns focus to the control that
			// opened it.
			document.addEventListener('keydown', event => {
				if (
					event.key === 'Escape' &&
					siteHeader.classList.contains('is-open')
				) {
					setMenu(false);
					navToggle.focus();
				}
			});

			// A resize past the breakpoint should not leave a stale open state.
			window
				.matchMedia('(min-width: 921px)')
				.addEventListener('change', event => {
					if (event.matches) setMenu(false);
				});

			// Moving focus out of the open menu closes it.
			document.addEventListener('focusin', event => {
				if (!siteHeader.classList.contains('is-open')) return;
				if (!siteHeader.contains(event.target as Node)) setMenu(false);
			});
		}

		syncThemeToggle();
	</script>

	<style>
		.site-header {
			position: sticky;
			top: 0;
			z-index: 30;
			backdrop-filter: blur(18px);
			background: rgba(248, 249, 252, 0.72);
			border-bottom: 1px solid rgba(229, 231, 239, 0.8);
		}

		:root[data-theme='dark'] .site-header {
			background: rgba(11, 15, 26, 0.72);
			border-bottom-color: rgba(35, 44, 68, 0.9);
		}

		.site-header__inner {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			width: 100%;
			max-width: 1400px;
			padding-inline: clamp(16px, 3vw, 40px);
			height: var(--header-height);
		}

		.brand {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			margin-right: auto;
			flex-shrink: 0;
		}

		.site-nav {
			display: flex;
			align-items: center;
			gap: 0.25rem;
		}

		.site-nav__link {
			display: inline-flex;
			align-items: center;
			padding: 0.7rem 0.9rem;
			border-radius: 999px;
			font-size: 0.96rem;
			font-weight: 600;
			color: var(--theme-muted);
			transition:
				color var(--transition),
				background var(--transition);
		}

		.site-nav__link:hover {
			color: var(--theme-on-bg);
		}

		/* aria-current="page" and the visual state are driven by the same
		   server-rendered attribute so they can never disagree. */
		.site-nav__link.is-active,
		.site-nav__link[aria-current='page'] {
			color: var(--color-brand-ink);
			background: rgba(109, 40, 217, 0.1);
		}

		.site-header__actions {
			display: flex;
			align-items: center;
			gap: 0.75rem;
		}

		.theme-toggle {
			position: relative;
			width: 2.75rem;
			height: 2.75rem;
			border: 1px solid var(--theme-border);
			background: rgba(255, 255, 255, 0.2);
			border-radius: 999px;
			display: grid;
			place-items: center;
			transition:
				transform var(--transition),
				border-color var(--transition),
				background var(--transition);
		}

		.theme-toggle:hover {
			transform: translateY(-1px);
			border-color: var(--color-brand-ink);
		}

		.theme-toggle__icon {
			position: absolute;
			width: 1.08rem;
			height: 1.08rem;
			transition:
				opacity var(--transition),
				transform var(--transition);
			color: var(--theme-on-bg);
		}

		.theme-toggle__icon--sun {
			opacity: 1;
		}
		.theme-toggle__icon--moon {
			opacity: 0;
			transform: scale(0.75);
		}
		.theme-toggle.is-dark .theme-toggle__icon--sun {
			opacity: 0;
			transform: scale(0.7);
		}
		.theme-toggle.is-dark .theme-toggle__icon--moon {
			opacity: 1;
			transform: scale(1);
		}

		.nav-toggle {
			display: none;
			align-items: center;
			justify-content: center;
			background: transparent;
			border: 1px solid var(--theme-border);
			border-radius: 999px;
			width: 2.75rem;
			height: 2.75rem;
			flex-shrink: 0;
		}

		.nav-toggle__bars {
			display: block;
			width: 1.2rem;
		}

		.nav-toggle__bars span {
			display: block;
			width: 100%;
			height: 2px;
			background: var(--theme-on-bg);
			border-radius: 999px;
			margin: 3px 0;
		}

		.site-footer {
			background: var(--theme-surface-1);
			border-top: 1px solid var(--theme-border);
			margin-top: clamp(2rem, 5vw, 4rem);
		}

		.site-footer__grid {
			display: grid;
			grid-template-columns: 1.6fr repeat(4, 1fr);
			gap: 2rem;
			padding: clamp(3rem, 6vw, 4.5rem) 0 2.5rem;
		}

		.footer-brand p {
			margin-top: 1rem;
			max-width: 24rem;
			color: var(--theme-muted);
		}

		.footer-column__title {
			margin-bottom: 1rem;
			font-size: 0.82rem;
			font-weight: 700;
			letter-spacing: 0.1em;
			text-transform: uppercase;
		}

		.footer-column ul {
			list-style: none;
			padding: 0;
			margin: 0;
			display: grid;
			gap: 0.6rem;
		}

		.footer-column a {
			color: var(--theme-muted);
		}

		.footer-column a:hover {
			color: var(--theme-on-bg);
			text-decoration: underline;
			text-underline-offset: 0.2em;
		}

		.site-footer__bottom {
			border-top: 1px solid var(--theme-border);
			padding: 1.1rem 0;
		}

		.site-footer__bottom-inner {
			color: var(--theme-muted);
			font-size: 0.92rem;
		}

		@media (max-width: 1080px) {
			.site-footer__grid {
				grid-template-columns: 1fr 1fr 1fr;
			}

			.footer-brand {
				grid-column: 1 / -1;
			}
		}

		@media (max-width: 920px) {
			.site-nav {
				display: none;
				position: absolute;
				top: 100%;
				left: 0;
				right: 0;
				padding: 1rem 1.25rem;
				background: var(--theme-surface-1);
				border-bottom: 1px solid var(--theme-border);
				box-shadow: var(--shadow-soft);
				flex-direction: column;
				align-items: stretch;
			}

			.site-header.is-open .site-nav {
				display: flex;
			}

			.site-nav__link {
				padding: 0.85rem 1rem;
			}

			.nav-toggle {
				display: inline-flex;
			}
		}

		@media (max-width: 640px) {
			.site-footer__grid {
				grid-template-columns: 1fr 1fr;
				gap: 2rem 1.5rem;
			}
		}

		@media (max-width: 420px) {
			.site-footer__grid {
				grid-template-columns: 1fr;
			}
		}
	</style>
</Layout>
