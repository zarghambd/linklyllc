---
import Layout from '../layouts/Page.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';

const capabilities = [
	{
		title: 'Autonomous workflow and task agents',
		description:
			'AI systems designed to execute multi-step business processes independently. From processing documents and triaging customer support tickets to managing internal workflows, agents reduce manual effort and remove operational bottlenecks.',
	},
	{
		title: 'Retrieval-augmented assistants',
		description:
			'Enterprise assistants grounded in your internal documentation, knowledge bases and databases. Teams can query proprietary data with citations back to the source, under access controls that match the permissions they already have.',
	},
	{
		title: 'Multi-agent orchestration',
		description:
			'Environments where specialised agents collaborate — passing data, calling tools and verifying each other’s output — to handle work like research, lead scoring, and financial analysis.',
	},
	{
		title: 'Custom AI integration and fine-tuning',
		description:
			'Foundation models connected directly to your APIs, CRM, ERP and databases, with behaviour tuned to your domain. We are explicit about when fine-tuning is worth the cost and when prompting and retrieval are enough.',
	},
];

const technologies = [
	{
		name: 'Commercial foundation models',
		role: 'Reasoning and generation',
		description:
			'Hosted frontier models for comprehension, structured output and tool use. Best when accuracy matters more than unit cost and your data terms permit it.',
	},
	{
		name: 'Agent frameworks',
		role: 'Orchestration',
		description:
			'Libraries for context management, tool use and prompt pipelines. We use the lightest one that solves the problem rather than the most capable one.',
	},
	{
		name: 'Self-hosted and fine-tuned models',
		role: 'Data residency and cost control',
		description:
			'Open-weight models hosted in your own environment, with custom embeddings, targeted fine-tuning and safety guardrails for the specific domain.',
	},
];

const process = [
	{
		title: 'Readiness and use-case mapping',
		description:
			'We review your workflows and data infrastructure to find where automation actually pays for itself, and where it does not.',
	},
	{
		title: 'Architecture and guardrail design',
		description:
			'System prompts, retrieval design, tool permissions and safety guardrails are agreed before any agent is built.',
	},
	{
		title: 'Engineering and integration',
		description:
			'We build the agents and connect them to your web or mobile applications through your own APIs.',
	},
	{
		title: 'Evaluation and testing',
		description:
			'Edge cases, output quality, latency, per-run cost and reliability are measured and reported, not assumed.',
	},
	{
		title: 'Deployment and monitoring',
		description:
			'Agents ship with telemetry, cost tracking and a feedback loop, so you can see what they are doing and what they cost.',
	},
];
---

<Layout
	seo={{
		title: 'AI Agent Development & Workflow Automation',
		description:
			'Linkly LLC builds AI agents, retrieval-augmented assistants and workflow automation connected to your existing systems, with guardrails and cost controls.',
	}}
>
	<div class="container page-shell">
		<header class="page-header">
			<p class="eyebrow">AI services</p>
			<h1>AI Agent Development Services</h1>
			<p class="page-header__lede">
				We build AI agents and workflow automation systems that take on the
				repetitive operational work. By combining language models with custom
				backend integration, we turn artificial intelligence into something your
				team can actually run.
			</p>
		</header>
	</div>

	<Section
		id="what-we-build"
		class="capabilities"
		eyebrow="What we build"
		title="Four things we get asked for"
	>
		<div class="card-grid">
			{
				capabilities.map(item => (
					<article class="card card-content">
						<h2 class="card-content__title">{item.title}</h2>
						<p class="card-content__text">{item.description}</p>
					</article>
				))
			}
		</div>
	</Section>

	<Section
		id="core-technologies"
		class="technologies"
		eyebrow="Core technologies"
		title="How it is built"
	>
		<div class="card-grid">
			{
				technologies.map(item => (
					<article class="card card-content">
						<p class="tech-card__role">{item.role}</p>
						<h2 class="card-content__title">{item.name}</h2>
						<p class="card-content__text">{item.description}</p>
					</article>
				))
			}
		</div>
	</Section>

	<Section
		id="process"
		class="process"
		eyebrow="How we deliver"
		title="Our implementation process"
	>
		<ol class="process-list">
			{
				process.map((step, index) => (
					<li class="card card-content">
						<span class="process-list__step" aria-hidden="true">
							{index + 1}
						</span>
						<div class="process-list__body">
							<h3 class="card-content__title">{step.title}</h3>
							<p class="card-content__text">{step.description}</p>
						</div>
					</li>
				))
			}
		</ol>
	</Section>

	<section class="container cta-wrap">
		<div class="cta-band">
			<div>
				<p class="eyebrow eyebrow--light">Next step</p>
				<h2>Find out where automation would pay off</h2>
			</div>
			<Button href="/contact" variant="light">Start a conversation</Button>
		</div>
	</section>
</Layout>

<style>
	.tech-card__role {
		order: -1;
		margin: 0 0 0.35rem;
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-brand-ink);
	}

	.tech-card__role + :global(.card-content__title) {
		margin-bottom: 0;
	}

	.process-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	.process-list__body {
		min-width: 0;
	}

	.process-list__step {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		background: linear-gradient(
			135deg,
			var(--color-gradient-from),
			var(--color-gradient-to)
		);
		color: #fff;
		font-family: var(--heading-font);
		font-weight: 800;
		font-size: 0.95rem;
	}

	.process-list li {
		flex-direction: row;
		align-items: flex-start;
		gap: 1rem;
	}

	.cta-wrap {
		padding-block: clamp(2rem, 4vw, 3rem);
	}

	.cta-band {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: clamp(1.5rem, 4vw, 2.5rem);
		border-radius: 24px;
		background: linear-gradient(
			135deg,
			var(--color-gradient-from),
			var(--color-gradient-to)
		);
		box-shadow: var(--shadow-soft);
	}

	.eyebrow--light {
		color: rgba(255, 255, 255, 0.9);
	}

	.cta-band h2 {
		margin-bottom: 0;
		color: #fff;
	}

	@media (max-width: 640px) {
		.cta-band {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
