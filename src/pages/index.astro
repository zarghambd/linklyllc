---
import Layout from '../layouts/Page.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import StatBand from '../components/StatBand.astro';
import TestimonialSection from '../components/TestimonialSection.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services, reasons, techStackGroups } from '../data/services';
import { stats } from '../data/stats';
import heroImage from '../../public/landing-hero.png';
import { Image } from 'astro:assets';
---

<Layout
	seo={{
		title: 'Custom Web Development, AI Automation & Mobile Apps',
		description:
			'Linkly LLC builds custom web applications, AI agents and workflow automation, and cross-platform mobile apps for growing US businesses.',
	}}
>
	<section class="hero container">
		<div class="hero__content">
			<p class="eyebrow">Web development agency</p>
			<h1>
				Custom <span class="gradient-text">Web Development</span> Services
			</h1>
			<p class="hero__lede">
				At <strong>Linkly LLC</strong>, we build modern, fast, and scalable web
				applications engineered to solve complex business challenges and drive
				measurable growth. We combine architecture, user experience, and
				delivery excellence to create digital products that feel premium and
				work reliably.
			</p>
			<div class="button-row">
				<Button href="/contact" variant="primary">Start a project</Button>
			</div>
		</div>

		<div class="hero__visual">
			<Image
				src={heroImage}
				alt="A Linkly LLC project dashboard open in a browser, showing a responsive web application interface built by the Linkly LLC team."
				width={1280}
				height={800}
				widths={[480, 768, 1024, 1280]}
				sizes="(min-width: 1024px) 620px, (min-width: 640px) 50vw, 92vw"
				loading="eager"
				fetchpriority="high"
				decoding="async"
				class="hero__image"
			/>
		</div>
	</section>

	<Section
		id="services"
		class="services"
		eyebrow="What we build"
		title="Custom solutions that scale"
	>
		<div class="card-grid">
			{services.map(service => <ServiceCard {service} />)}
		</div>
	</Section>

	<Section
		class="stack"
		eyebrow="Technology"
		title="Built with the modern web stack"
	>
		<div class="stack-group-list">
			{techStackGroups.map(group => (
				<div class="stack-group">
					<h3>{group.title}</h3>
					<ul class="tech-pills">
						{group.items.map(item => <li class="tech-pill">{item}</li>)}
					</ul>
				</div>
			))}
		</div>
	</Section>

	<Section
		class="reasons"
		eyebrow="Why Linkly LLC"
		title="Why partner with Linkly LLC?"
	>
		<div class="card-grid">
			{reasons.map(reason => <ServiceCard {reason} />)}
		</div>
	</Section>

	<StatBand heading="Linkly LLC in numbers" items={stats} />

	<TestimonialSection />

	<section class="container cta-wrap">
		<div class="cta-band">
			<div>
				<p class="eyebrow eyebrow--light">Ready when you are</p>
				<h2>Have a project in mind?</h2>
			</div>
			<Button href="/contact" variant="light">Start a conversation</Button>
		</div>
	</section>
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		align-items: center;
		gap: clamp(2rem, 4vw, 3rem);
		padding-top: clamp(2.5rem, 6vw, 4.5rem);
		padding-bottom: clamp(1.5rem, 3vw, 2rem);
	}

	.hero__content {
		max-width: 40rem;
		min-width: 0;
	}

	.hero__lede {
		max-width: 62ch;
		font-size: 1.08rem;
		color: var(--theme-muted);
	}

	.button-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}

	.hero__visual {
		display: grid;
		place-items: center;
		min-width: 0;
	}

	/* astro:assets emits width/height attributes, so the box is reserved
	   before the image loads and there is no layout shift. */
	.hero__image {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--theme-border);
		border-radius: 20px;
		box-shadow: var(--shadow-soft);
	}

	.stack-group-list {
		display: grid;
		gap: 1.5rem;
	}

	.stack-group {
		display: grid;
		gap: 0.85rem;
	}

	.stack-group h3 {
		margin: 0;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--theme-on-bg);
	}

	.tech-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.tech-pill {
		display: inline-flex;
		align-items: center;
		padding: 0.8rem 1rem;
		border-radius: 999px;
		background: var(--theme-surface-1);
		border: 1px solid var(--theme-border);
		font-weight: 600;
		color: var(--theme-on-bg);
	}

	.cta-wrap {
		padding-block: clamp(2rem, 4vw, 3rem);
	}

	.cta-band {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: clamp(1.5rem, 4vw, 2.5rem);
		border-radius: 24px;
		background: linear-gradient(
			135deg,
			var(--color-gradient-from),
			var(--color-gradient-to)
		);
		color: #fff;
		box-shadow: var(--shadow-soft);
	}

	.eyebrow--light {
		color: rgba(255, 255, 255, 0.9);
	}

	.cta-band h2 {
		margin-bottom: 0;
		color: #fff;
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.button-row {
			flex-direction: column;
			align-items: stretch;
		}

		.button-row :global(.btn) {
			width: 100%;
		}

		.cta-band {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
