---
import Layout from '../layouts/Page.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';

const capabilities = [
	{
		title: 'Cross-platform mobile applications',
		description:
			'Single-codebase apps engineered to run on both iOS and Android. One product, one codebase to maintain, and the platform look and feel preserved where it matters.',
	},
	{
		title: 'Consumer apps and digital products',
		description:
			'Interfaces designed with retention in mind: real-time messaging, push notifications, offline storage, biometrics and secure payment integration.',
	},
	{
		title: 'Enterprise mobile solutions',
		description:
			'Secure tools for field staff, remote teams and operational management — custom dashboards, field data collection and productivity suites connected to your core backend.',
	},
	{
		title: 'App modernization and refactoring',
		description:
			'Updating legacy applications to a current architecture: interface responsiveness, memory management, and outdated third-party dependencies that now block store submission.',
	},
];

const technologies = [
	{
		name: 'React Native',
		role: 'JavaScript and TypeScript',
		description:
			'Native UI components with fast iteration, a large ecosystem, and the option to share logic with an existing web codebase. Our default choice when you already have a React team.',
	},
	{
		name: 'Flutter',
		role: 'Dart',
		description:
			'Consistent rendering across screen sizes and platforms, with strong custom widget support. Worth the Dart learning curve when visual consistency matters more than sharing code with the web.',
	},
];

const process = [
	{
		title: 'Touch-first prototyping',
		description:
			'Wireframes and interactive prototypes built to the Apple Human Interface Guidelines and Material Design, tested on real devices before a line of app code is written.',
	},
	{
		title: 'Cross-platform engineering',
		description:
			'Modular React Native or Flutter code with offline-first synchronisation and predictable state management.',
	},
	{
		title: 'Device feature integration',
		description:
			'Camera, GPS, Bluetooth, biometric authentication, push notifications and local storage, integrated against the native platform APIs.',
	},
	{
		title: 'Quality assurance',
		description:
			'Tested across physical devices, form factors, screen densities, OS versions and degraded network conditions — not just emulators.',
	},
	{
		title: 'Store submission and support',
		description:
			'We handle signing, compliance review and submission to the App Store and Google Play, and stay on for post-launch updates.',
	},
];
---

<Layout
	seo={{
		title: 'Mobile App Development for iOS and Android',
		description:
			'Linkly LLC builds cross-platform iOS and Android apps with React Native and Flutter, from prototype through store submission and post-launch support.',
	}}
>
	<div class="container page-shell">
		<header class="page-header">
			<p class="eyebrow">Mobile services</p>
			<h1>Mobile App Development Services</h1>
			<p class="page-header__lede">
				We craft high-performing, cross-platform mobile applications for iOS and
				Android that deliver a native-grade experience. Using modern
				cross-platform frameworks, we help you launch feature-rich mobile
				products faster without sacrificing performance or design quality.
			</p>
		</header>
	</div>

	<Section
		id="what-we-build"
		class="capabilities"
		eyebrow="What we build"
		title="Mobile work we take on"
	>
		<div class="card-grid">
			{
				capabilities.map(item => (
					<article class="card card-content">
						<h2 class="card-content__title">{item.title}</h2>
						<p class="card-content__text">{item.description}</p>
					</article>
				))
			}
		</div>
	</Section>

	<Section
		id="core-technologies"
		class="technologies"
		eyebrow="Core technologies"
		title="How it is built"
	>
		<div class="card-grid">
			{
				technologies.map(item => (
					<article class="card card-content">
						<p class="tech-card__role">{item.role}</p>
						<h2 class="card-content__title">{item.name}</h2>
						<p class="card-content__text">{item.description}</p>
					</article>
				))
			}
		</div>
	</Section>

	<Section
		id="process"
		class="process"
		eyebrow="How we deliver"
		title="Our mobile engineering process"
	>
		<ol class="process-list">
			{
				process.map((step, index) => (
					<li class="card card-content">
						<span class="process-list__step" aria-hidden="true">
							{index + 1}
						</span>
						<div class="process-list__body">
							<h3 class="card-content__title">{step.title}</h3>
							<p class="card-content__text">{step.description}</p>
						</div>
					</li>
				))
			}
		</ol>
	</Section>

	<section class="container cta-wrap">
		<div class="cta-band">
			<div>
				<p class="eyebrow eyebrow--light">Next step</p>
				<h2>Scope your app before you commit</h2>
			</div>
			<Button href="/contact" variant="light">Start a project</Button>
		</div>
	</section>
</Layout>

<style>
	.tech-card__role {
		order: -1;
		margin: 0 0 0.35rem;
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-brand-ink);
	}

	.tech-card__role + :global(.card-content__title) {
		margin-bottom: 0;
	}

	.process-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	.process-list__body {
		min-width: 0;
	}

	.process-list__step {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		background: linear-gradient(
			135deg,
			var(--color-gradient-from),
			var(--color-gradient-to)
		);
		color: #fff;
		font-family: var(--heading-font);
		font-weight: 800;
		font-size: 0.95rem;
	}

	.process-list li {
		flex-direction: row;
		align-items: flex-start;
		gap: 1rem;
	}

	.cta-wrap {
		padding-block: clamp(2rem, 4vw, 3rem);
	}

	.cta-band {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: clamp(1.5rem, 4vw, 2.5rem);
		border-radius: 24px;
		background: linear-gradient(
			135deg,
			var(--color-gradient-from),
			var(--color-gradient-to)
		);
		box-shadow: var(--shadow-soft);
	}

	.eyebrow--light {
		color: rgba(255, 255, 255, 0.9);
	}

	.cta-band h2 {
		margin-bottom: 0;
		color: #fff;
	}

	@media (max-width: 640px) {
		.cta-band {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
