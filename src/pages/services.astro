---
import Layout from '../layouts/Page.astro';
import Section from '../components/Section.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Button from '../components/Button.astro';
import { services, serviceGroups, techStackGroups } from '../data/services';
---

<Layout
	seo={{
		title: 'Services — Web Development, AI Automation & Mobile Apps',
		description:
			'Linkly LLC builds enterprise web applications, backend APIs, headless CMS and e-commerce platforms, AI automation and agents, and cross-platform mobile apps.',
	}}
>
	<div class="container page-shell">
		<header class="page-header">
			<p class="eyebrow">What we do</p>
			<h1>Custom Web Development Services</h1>
			<p class="page-header__lede">
				We build three things: web platforms, the systems behind them, and the
				automation that keeps them running. Every engagement starts with a
				written scope, so you know what you are buying before anything is
				billed.
			</p>
		</header>
	</div>

	<Section
		id="web-development"
		class="services"
		eyebrow="Web development"
		title="Web platforms, front to back"
	>
		<div class="card-grid">
			{
				services
					.filter(service => service.group === 'web')
					.map(service => <ServiceCard {service} />)
			}
		</div>
	</Section>

	<Section
		id="ai-automation"
		class="services"
		eyebrow={serviceGroups.ai}
		title="AI automation and agents"
	>
		<div class="card-grid">
			{
				services
					.filter(service => service.group === 'ai')
					.map(service => <ServiceCard {service} />)
			}
		</div>
		<p class="section-footnote">
			See the full breakdown of agent types, retrieval-augmented assistants and
			integration patterns in <a class="link" href="/ai-agents"
				>AI Agent Development</a
			>.
		</p>
	</Section>

	<Section
		id="mobile"
		class="services"
		eyebrow={serviceGroups.mobile}
		title="Mobile apps"
	>
		<div class="card-grid">
			{
				services
					.filter(service => service.group === 'mobile')
					.map(service => <ServiceCard {service} />)
			}
		</div>
		<p class="section-footnote">
			Frameworks, release pipelines and store submission are covered in
			<a class="link" href="/mobile-apps">Mobile App Development</a>.
		</p>
	</Section>

	<Section class="stack" eyebrow="Technology" title="The stack we build with">
		<div class="stack-group-list">
			{techStackGroups.map(group => (
				<div class="stack-group">
					<h3>{group.title}</h3>
					<ul class="tech-pills">
						{group.items.map(item => <li class="tech-pill">{item}</li>)}
					</ul>
				</div>
			))}
		</div>
	</Section>

	<section class="container cta-wrap">
		<div class="cta-band">
			<div>
				<p class="eyebrow eyebrow--light">Next step</p>
				<h2>Get a written scope and a fixed price</h2>
			</div>
			<Button href="/contact" variant="light">Start a project</Button>
		</div>
	</section>
</Layout>

<style>
	.section-footnote {
		margin-top: 1.5rem;
		color: var(--theme-muted);
	}

	.stack-group-list {
		display: grid;
		gap: 1.5rem;
	}

	.stack-group {
		display: grid;
		gap: 0.85rem;
	}

	.stack-group h3 {
		margin: 0;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--theme-on-bg);
	}

	.tech-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.tech-pill {
		display: inline-flex;
		align-items: center;
		padding: 0.8rem 1rem;
		border-radius: 999px;
		background: var(--theme-surface-1);
		border: 1px solid var(--theme-border);
		font-weight: 600;
		color: var(--theme-on-bg);
	}

	.cta-wrap {
		padding-block: clamp(2rem, 4vw, 3rem);
	}

	.cta-band {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: clamp(1.5rem, 4vw, 2.5rem);
		border-radius: 24px;
		background: linear-gradient(
			135deg,
			var(--color-gradient-from),
			var(--color-gradient-to)
		);
		box-shadow: var(--shadow-soft);
	}

	.eyebrow--light {
		color: rgba(255, 255, 255, 0.9);
	}

	.cta-band h2 {
		margin-bottom: 0;
		color: #fff;
	}

	@media (max-width: 640px) {
		.cta-band {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
